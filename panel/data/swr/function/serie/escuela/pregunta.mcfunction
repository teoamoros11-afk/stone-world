# A20 - La escuela y el examen (T4, ep. 86-87). Tres preguntas, tres aciertos.
# Uso: /function swr:serie/escuela/pregunta
execute unless score EXAMEN_ACTIVO serie matches 1 run scoreboard players set EXAMEN_ACIERTOS serie 0
execute unless score EXAMEN_ACTIVO serie matches 1 run scoreboard players set EXAMEN_PREG serie 1
scoreboard players set EXAMEN_ACTIVO serie 1
execute if score EXAMEN_PREG serie matches 1 run tellraw @s [{"text":"[Escuela] ","color":"gold","bold":true},{"text":"Pregunta 1: para el fluido milagroso, ¿que acido se usa?","color":"yellow"}]
