tellraw @a [{"text": "[Cuaderno] ", "color": "gold", "bold": true}, {"text": "Mapa por eras. Pasa el raton por encima para ver el detalle, haz clic para abrirla y usa (ir) para ir al sitio.", "color": "gray"}, {"text": " El progreso es de los dos: una era y un cuaderno para la partida entera.", "color": "dark_gray"}]
