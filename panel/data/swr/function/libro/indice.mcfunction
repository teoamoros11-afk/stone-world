ray"}, {"text": "  (ir)", "color": "dark_aqua", "extra": [{"text": "", "clickEvent": {"action": "run_command", "value": "/tp @s -260 ~ -200"}, "hoverEvent": {"action": "show_text", "value": {"text": "", "extra": [{"text": "Te deja encima de Aldea de Ishigami (-370, -300), junto al Town Hall", "color": "white"}]}}}]}]
