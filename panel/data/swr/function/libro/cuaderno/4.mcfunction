give @a written_book[minecraft:written_book_content={title:"Cuaderno de campo (21/26)",author:"Reino de la Ciencia",pages:['[{"text": "CUADERNO DE CAMPO", "color": "gold", "bold": true}, {"text": " - "}, {"text": "Reino de la Ciencia", "color": "yellow"}, {"text": "  -  "}, {"text": "Fichas anotadas: 21 de 26", "color": "white"}, {"text": " "}, {"text": "Cada era anade formulas. Las que faltan no salen hasta que las descubras.", "color": "gray"}]','[{"text": "MAPA DEL REINO", "color": "gold", "bold": true}, {"text": "  -  "}, {"text": "Los ocho sitios estan en ISLA.md y en /function swr:viaje/*", "color": "gray"}, {"text": " "}, {"text": "Cueva del milagro, campo de estatuas, aldea, cascada, puerto, bambu, rival y playa.", "color": "white"}]','[{"text": "ERA 1 - No morir", "color": "yellow", "bold": true}, {"text": " "}, {"text": "Cueva del milagro (110, -490) y campo de estatuas (290, 10)", "color": "gray"}, {"text": "  -  "}, {"text": "Fichas: Fuego por friccion, Carbon vegetal, Ceramica y crisoles, Fluido milagroso (nitalo)", "color": "white"}]','[{"text": "Fuego por friccion", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Madera, cuerda, piedra seca y yesca", "color": "gray"}, {"text": "  -  "}, {"text": "W = F*d ; 1 J = 0,24 cal. Frotar convierte trabajo en calor y la yesca prende hacia 250 C.", "color": "white"}, {"text": "  -  "}, {"text": "Es lo primero que construye Senku al salir de la piedra (cap. 1).", "color": "dark_gray"}]','[{"text": "Carbon vegetal", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Lena apilada y tapada con tierra", "color": "gray"}, {"text": "  -  "}, {"text": "Pirolisis: C6H10O5 -> 6 C + 5 H2O + volatiles. Rinde cerca del 25 % del peso seco.", "color": "white"}, {"text": "  -  "}, {"text": "Sin carbon no hay hierro: es la llave de toda la metalurgia.", "color": "dark_gray"}]','[{"text": "Ceramica y crisoles", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Arcilla, agua y horno de tiro natural", "color": "gray"}, {"text": "  -  "}, {"text": "Caolinita Al2Si2O5(OH)4 -> metacaolin + 2 H2O entre 500 y 600 C; aguanta 900 C.", "color": "white"}, {"text": "  -  "}, {"text": "Crisoles y moldes: sin ceramica no se puede fundir nada.", "color": "dark_gray"}]','[{"text": "Fluido milagroso (nitalo)", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Nitrato (salitre o guano), acido sulfurico y alcohol", "color": "gray"}, {"text": "  -  "}, {"text": "NaNO3 + H2SO4 -> NaHSO4 + HNO3 (destilando). Nitalo = HNO3 + C2H5OH.", "color": "white"}, {"text": "  -  "}, {"text": "Solo deshace la piedra de un cuerpo intacto: las estatuas rotas no vuelven.", "color": "dark_gray"}]','[{"text": "ERA 2 - Ganarse la aldea", "color": "yellow", "bold": true}, {"text": " "}, {"text": "Aldea de Ishigami (-370, -300), junto al Town Hall", "color": "gray"}, {"text": "  -  "}, {"text": "Fichas: Vidrio, Lentes y microscopio, Dinamo de manivela, Bombilla, Sulfamidas, El pueblo de los agradecidos, Cada vecino, su casa, El dia del pueblo, Los oficios y sus puestos", "color": "white"}]','[{"text": "Vidrio", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Arena, sosa (ceniza) y caliza a 1200-1400 C", "color": "gray"}, {"text": "  -  "}, {"text": "SiO2 + Na2CO3 + CaCO3 -> silicato fundido + CO2. El Na2O baja el punto de fusion.", "color": "white"}, {"text": "  -  "}, {"text": "El vidrio multiplica la quimica: recipientes, tubos y lentes.", "color": "dark_gray"}]','[{"text": "Lentes y microscopio", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Vidrio, abrasivo cada vez mas fino, paciencia", "color": "gray"}, {"text": "  -  "}, {"text": "Lente delgada: 1/f = 1/s + 1/s prima. Microscopio: M = (L/f_obj)*(D/f_oc).", "color": "white"}, {"text": "  -  "}, {"text": "Sin instrumentos no hay ciencia fina, solo observacion a ojo.", "color": "dark_gray"}]','[{"text": "Dinamo de manivela", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Cobre, imanes, madera y dos pares de manos", "color": "gray"}, {"text": "  -  "}, {"text": "Faraday: e = -N*dPhi/dt. Potencia P = V*I. Una manivela da para una bombilla, no para una aldea.", "color": "white"}, {"text": "  -  "}, {"text": "Aqui la pone el mod crank-dynamo del pack: 8 FE por tick girando.", "color": "dark_gray"}]','[{"text": "Bombilla", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Filamento de bambu carbonizado y vidrio en vacio", "color": "gray"}, {"text": "  -  "}, {"text": "P = V cuadrado / R. El filamento se pone incandescente y el vacio evita que se queme.", "color": "white"}, {"text": "  -  "}, {"text": "Es la bombilla de Edison, y la serie la reproduce con fidelidad.", "color": "dark_gray"}]','[{"text": "Sulfamidas", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Azufre, azucar y frasco (mod Stone Pharmacy)", "color": "gray"}, {"text": "  -  "}, {"text": "Sulfanilamida C6H8N2O2S: el grupo -SO2NH2 corta la sintesis de acido folico de la bacteria y la deja sin multiplicarse.", "color": "white"}, {"text": "  -  "}, {"text": "Es el invento que salva a Ruri y el que separa la medicina de la supersticion.", "color": "dark_gray"}]','[{"text": "El pueblo de los agradecidos", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Tres despetrificados y un solar llano", "color": "gray"}, {"text": "  -  "}, {"text": "3 vecinos -> plaza de 9x9 con campana; 1 casa de 5x5 por vecino en 16 solares; obra general: 45 s y 6 etapas.", "color": "white"}, {"text": "  -  "}, {"text": "La gratitud como mano de obra: nadie pide permiso para levantar su casa. Mision: /function swr:pueblo/obra/iniciar.", "color": "dark_gray"}]','[{"text": "Cada vecino, su casa", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "16 solares alrededor de la plaza", "color": "gray"}, {"text": "  -  "}, {"text": "Suelo de piedra, tres capas de muro, techo con vuelo, cama, cofre y puerta mirando a la plaza; 30 s por casa, una tanda a la vez y cola de espera.", "color": "white"}, {"text": "  -  "}, {"text": "Una casa por vecino, 16 como maximo: el que llega tarde espera turno. Todo el detalle en PUEBLO.md.", "color": "dark_gray"}]','[{"text": "El dia del pueblo", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Pan, campana y una cama por casa", "color": "gray"}, {"text": "  -  "}, {"text": "Amanecer en la plaza, manana y tarde de trabajo en el puesto de su oficio (cortapiedras, compostador, telar, barril, mesa de flechas o atril, cada uno con su mesa y su sonido), comida a mediodia, reunion al atardecer y noche en casa. /function swr:pueblo/horario/iniciar", "color": "white"}, {"text": "  -  "}, {"text": "Minecraft no le da hambre ni sueño a un aldeano: la rutina la pone el datapack y el jugador la ve pasar. Los puestos si son bloques de trabajo reales.", "color": "dark_gray"}]','[{"text": "Los oficios y sus puestos", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Seis puestos con su cofre de produccion", "color": "gray"}, {"text": "  -  "}, {"text": "Cantero (cortapiedras): ladrillos; granjero (compostador): pan; pastor (telar): lana; pescador (barril): bacalao; flechero (mesa de flechas): flechas; bibliotecario (atril): libros. Cada minuto de trabajo el puesto deja su parte en el cofre de al lado.", "color": "white"}, {"text": "  -  "}, {"text": "El que sale de la piedra coge el oficio que falta y al amanecer se reparte: si uno va cargado, sus vecinos se pasan al que esta vacio (hasta tres por dia).", "color": "dark_gray"}]','[{"text": "ERA 3 - Stone Wars", "color": "yellow", "bold": true}, {"text": " "}, {"text": "Cascada y central (-120, -10), tendido hasta la aldea", "color": "gray"}, {"text": "  -  "}, {"text": "Fichas: Hierro por tatara, Bateria de plomo-acido, Acidos y polvora, Central hidroelectrica", "color": "white"}]','[{"text": "Hierro por tatara", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Arena de hierro, carbon y aire forzado", "color": "gray"}, {"text": "  -  "}, {"text": "Fe2O3 + 3 CO -> 2 Fe + 3 CO2. El carbon no arde: reduce el oxido.", "color": "white"}, {"text": "  -  "}, {"text": "La tatara historica trabaja dias; el manga lo comprime a una sesion.", "color": "dark_gray"}]','[{"text": "Bateria de plomo-acido", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Placas de plomo, acido sulfurico y caja estanca", "color": "gray"}, {"text": "  -  "}, {"text": "Pb + PbO2 + 2 H2SO4 <-> 2 PbSO4 + 2 H2O; unos 2,1 V por celda.", "color": "white"}, {"text": "  -  "}, {"text": "Almacenar energia es lo que permite pelear de noche.", "color": "dark_gray"}]','[{"text": "Acidos y polvora", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Azufre, nitratos, carbon vegetal y salitre", "color": "gray"}, {"text": "  -  "}, {"text": "S + O2 -> SO2 ; SO2 + H2O -> H2SO3 -> H2SO4. Polvora: 75 KNO3 / 15 C / 10 S.", "color": "white"}, {"text": "  -  "}, {"text": "Es la parte mas peligrosa del proyecto; la serie no muestra los humos.", "color": "dark_gray"}]','[{"text": "Central hidroelectrica", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Salto de 18 bloques, turbina y generador", "color": "gray"}, {"text": "  -  "}, {"text": "P = rho*g*Q*h*eta. Con 18 m de salto y 1 m3/s salen unos 130 kW teoricos.", "color": "white"}, {"text": "  -  "}, {"text": "La cascada de la isla es la que hace posible el tendido electrico.", "color": "dark_gray"}]','[{"text": "ERA 4 - New World", "color": "yellow", "bold": true}, {"text": " "}, {"text": "Puerto y astillero (-50, 450); isla del tesoro a 3000 al este", "color": "gray"}, {"text": "  -  "}, {"text": "Fichas: Brujula, El Perseus, Petroleo y refino, La medusa", "color": "white"}]','[{"text": "Brujula", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Aguja de hierro y magnetita", "color": "gray"}, {"text": "  -  "}, {"text": "Magnetita Fe3O4. La aguja se alinea con el campo terrestre, de 25 a 65 microteslas.", "color": "white"}, {"text": "  -  "}, {"text": "Sin brujula no hay navegacion oceanica fiable.", "color": "dark_gray"}]','[{"text": "El Perseus", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Roble curado, clavos, brea, velas cosidas y timon", "color": "gray"}, {"text": "  -  "}, {"text": "Arquimedes: E = rho*g*V. Un casco de 40 t desplaza 40 m3 de agua.", "color": "white"}, {"text": "  -  "}, {"text": "El barco es un proyecto, no un objeto: meses de carpinteria de ribera.", "color": "dark_gray"}]','[{"text": "Petroleo y refino", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "Pozo, alambique y columnas de destilacion", "color": "gray"}, {"text": "  -  "}, {"text": "Separar por punto de ebullicion: gases bajo 0 C, gasolina 40-200, queroseno 175-325, gasoleo 250-400.", "color": "white"}, {"text": "  -  "}, {"text": "El petroleo cambia la escala: de taller a industria.", "color": "dark_gray"}]','[{"text": "La medusa", "color": "aqua", "bold": true}, {"text": "  -  "}, {"text": "El dispositivo de la isla del tesoro", "color": "gray"}, {"text": "  -  "}, {"text": "No tiene formula: es la licencia fantastica del manga. Lo que si es real es el miedo como tecnologia.", "color": "white"}, {"text": "  -  "}, {"text": "Ibara no gobernaba con la medusa, gobernaba con el relato.", "color": "dark_gray"}]','[{"text": "CADENA DEL PERSEUS", "color": "gold", "bold": true}, {"text": "  -  "}, {"text": "1) Astillero en el puerto, zona 5. 2) Casco y cubierta. 3) Botadura: /function swr:tripulacion/botadura. 4) Tripulacion: navegante, contable y cocinero. 5) Zarpe: /function swr:tripulacion/zarpar. 6) Isla del tesoro, 3.000 al este, en bote. 7) Vuelta con platino y la medusa.", "color": "white"}]','[{"text": "SIN ANOTAR", "color": "dark_red", "bold": true}, {"text": "  -  "}, {"text": "Quedan 5 fichas de las eras siguientes. Se anotan al abrirlas o con /function swr:descubrir/N.", "color": "gray"}]']}]
