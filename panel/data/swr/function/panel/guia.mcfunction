# Libro de instrucciones del Panel del pueblo. Se entrega UNA sola vez, la primera vez que
# llega el panel (panel/dar lo llama si el jugador no tiene aun la marca swr_guia_panel).
# Pagina 9: lo que produce cada puesto y cada cuanto. Pagina 10: atajos que se copian al pulsarlos.
give @s written_book[minecraft:written_book_content={title:"Instrucciones del Panel",author:"Reino de la Ciencia",pages:['{"text":"PANEL DEL PUEBLO","bold":true,"color":"gold","underlined":true}','{"text":"Lo que hace el pueblo y su progreso, en un objeto. Llega solo al entrar por primera vez o tras un /reload."}','{"text":"COMO SE ABRE: en la barra rapida, pulsa la tecla del hueco del panel (1..9). Y este mismo libro tambien lo abre: llevalo en la mano (o en la otra mano) y sale solo."}','{"text":"QUE CUENTA: era y fichas del cuaderno, vecinos salidos de la piedra, estatuas en pie y fluido que queda."}','{"text":"Tambien: casas empezadas y en obra, puestos en pie, turno del horario, cuantos vecinos hay en cada oficio y que deja su cofre cada minuto. Y la obra, en marcha o parada.","color":"dark_gray"}','{"text":"SI SE PIERDE: /function swr:panel/dar","color":"dark_gray"}','{"text":"SIN EL OBJETO: /function swr:panel/ver","color":"dark_gray"}','{"text":"DETALLE DEL PUEBLO: /function swr:pueblo/estado","color":"dark_gray"}','{"text":"LO QUE PRODUCE CADA PUESTO. Cantero: 3 ladrillos. Granjero: 2 panes. Pastor: 2 lanas. Pescador: 2 bacalaos. Flechero: 6 flechas. Bibliotecario: 1 libro. Cada minuto de trabajo (manana y tarde), si hay un vecino en el puesto.","color":"dark_gray"}','[{"text":"ATAJOS: toca una palabra y se copia al portapapeles.","color":"gold","bold":true},{"text":" Estado","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/estado"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/estado"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Petrificar","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/estatua"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/estatua"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Revivir","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/despetrificar"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/despetrificar"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Horario","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/horario/iniciar"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/horario/iniciar"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Parar","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/horario/parar"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/horario/parar"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Obra","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:pueblo/obra/iniciar"},"hoverEvent":{"action":"show_text","value":"/function swr:pueblo/obra/iniciar"},"color":"aqua","underlined":true},{"text":" · ","color":"gray"},{"text":"Cuaderno","clickEvent":{"action":"copy_to_clipboard","value":"/function swr:libro/cuaderno"},"hoverEvent":{"action":"show_text","value":"/function swr:libro/cuaderno"},"color":"aqua","underlined":true},{"text":" Pasa el raton por encima para ver el comando y pulsa para copiarlo.","color":"dark_gray"}]']}] 1
