tellraw @s [{"text":"[Panel] ","color":"gold","bold":true},{"text":"Tambien te dejo el libro ","color":"white"},{"text":"Instrucciones del Panel","color":"gold","italic":true},{"text":" (diez paginas: produccion y atajos copiables). Llevalo en la mano y abre el panel igual que la brujula.","color":"white"}]
